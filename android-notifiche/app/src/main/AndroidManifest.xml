<?xml version="1.0" encoding="utf-8"?>
<!-- App di prova D-102: nessun permesso (niente INTERNET), nessun backup. Il workflow controlla l'APK finale. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Solo per sapere se l'app ING è installata (visibilità dei pacchetti da Android 11): non è un permesso. -->
    <queries>
        <package android:name="it.ing.banking" />
        <package android:name="it.ingdirect.app" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/regole_dati"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/nome_app"
        android:supportsRtl="false"
        android:theme="@style/Tema">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Il permesso qui sotto protegge il servizio: solo Android può collegarsi.
             Non è un permesso chiesto dall'app: l'accesso lo dà l'utente in "Accesso alle notifiche". -->
        <service
            android:name=".Ascoltatore"
            android:exported="true"
            android:label="@string/nome_servizio"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
